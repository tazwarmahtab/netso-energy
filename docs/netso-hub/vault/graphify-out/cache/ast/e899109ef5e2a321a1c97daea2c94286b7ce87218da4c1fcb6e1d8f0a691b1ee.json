w_calls": [{"caller_nid": "components_teamchatview_geminiteamchat", "callee": "useCallback", "is_member_call": false, "source_file": "/Users/tazwarmahtab/Netso Energy/wiki/raw/imports/Documents_HQ/Strategy/netso website final/AionUi/src/renderer/pages/team/components/TeamChatView.tsx", "source_location": "L23"}, {"caller_nid": "components_teamchatview_geminiteamchat", "callee": "useGeminiModelSelection", "is_member_call": false, "source_file": "/Users/tazwarmahtab/Netso Energy/wiki/raw/imports/Documents_HQ/Strategy/netso website final/AionUi/src/renderer/pages/team/components/TeamChatView.tsx", "source_location": "L32"}, {"caller_nid": "components_teamchatview_aionrsteamchat", "callee": "useCallback", "is_member_call": false, "source_file": "/Users/tazwarmahtab/Netso Energy/wiki/raw/imports/Documents_HQ/Strategy/netso website final/AionUi/src/renderer/pages/team/components/TeamChatView.tsx", "source_location": "L51"}, {"caller_nid": "components_teamchatview_aionrsteamchat", "callee": "useAionrsModelSelection", "is_member_call": false, "source_file": "/Users/tazwarmahtab/Netso Energy/wiki/raw/imports/Documents_HQ/Strategy/netso website final/AionUi/src/renderer/pages/team/components/TeamChatView.tsx", "source_location": "L60"}, {"caller_nid": "components_teamchatview_teamchatview", "callee": "(() => {\n    switch (conversation.type) {\n      case 'acp':\n        return (\n          <AcpChat\n            key={conversation.id}\n            conversation_id={conversation.id}\n            workspace={conversation.extra?.workspace}\n            backend={conversation.extra?.backend || 'claude'}\n            sessionMode={conversation.extra?.sessionMode}\n            agentName={(conversation.extra as { agentName?: string })?.agentName}\n            hideSendBox={hideSendBox}\n            teamId={teamId}\n            agentSlotId={agentSlotId}\n          />\n        );\n      case 'codex': // Legacy: codex now uses ACP protocol\n        return (\n          <AcpChat\n            key={conversation.id}\n            conversation_id={conversation.id}\n            workspace={conversation.extra?.workspace}\n            backend='codex'\n            hideSendBox={hideSendBox}\n            teamId={teamId}\n            agentSlotId={agentSlotId}\n          />\n        );\n      case 'aionrs':\n        return <AionrsTeamChat key={conversation.id} conversation={conversation as AionrsConversation} />;\n      case 'gemini':\n        return <GeminiTeamChat key={conversation.id} conversation={conversation} hideSendBox={hideSendBox} />;\n      case 'openclaw-gateway':\n        return (\n          <OpenClawChat\n            key={conversation.id}\n            conversation_id={conversation.id}\n            workspace={conversation.extra?.workspace}\n            hideSendBox={hideSendBox}\n          />\n        );\n      case 'nanobot':\n        return (\n          <NanobotChat\n            key={conversation.id}\n            conversation_id={conversation.id}\n            workspace={conversation.extra?.workspace}\n            hideSendBox={hideSendBox}\n          />\n        );\n      case 'remote':\n        return (\n          <RemoteChat\n            key={conversation.id}\n            conversation_id={conversation.id}\n            workspace={conversation.extra?.workspace}\n            hideSendBox={hideSendBox}\n          />\n        );\n      default:\n        return null;\n    }\n  })", "is_member_call": false, "source_file": "/Users/tazwarmahtab/Netso Energy/wiki/raw/imports/Documents_HQ/Strategy/netso website final/AionUi/src/renderer/pages/team/components/TeamChatView.tsx", "source_location": "L85"}]}