<file path="src/lib/gsap-scroll.ts">
/**
 * gsap-scroll.ts
 * GSAP ScrollTrigger cinema for the Netso 3D website.
 *
 * GSAP + ScrollTrigger are loaded via CDN — see index.html.
 * Type references come from @types/gsap (devDependency).
 * Runtime values accessed via window globals.
 *
 * Phase 2 — GSAP Scroll Cinema foundation.
 */
import type { default as GsapType } from 'gsap'
import type { default as ScrollTriggerType } from 'gsap/ScrollTrigger'

// Runtime globals (CDN)
type Gsap = typeof GsapType
type ScrollTrigger = typeof ScrollTriggerType
type GSAPInstance = Gsap & { ScrollTrigger: ScrollTrigger }

const $gsap = (window as unknown as { gsap: GSAPInstance }).gsap
const $ScrollTrigger = (window as unknown as { ScrollTrigger: ScrollTrigger }).ScrollTrigger

// ── Color tokens ───────────────────────────────────────────────────────
const GOLD_RGB = '245, 158, 11'

// ── Initialise all Netso scroll triggers ─────────────────────────────
export function initNetsoScroll(): void {
  if (typeof window === 'undefined' || window.innerWidth < 768) return
  if (!$gsap || !$ScrollTrigger) {
    console.warn('[gsap-scroll] GSAP CDN not loaded yet — scroll cinema deferred.')
    return
  }

  // Register plugin
  ;($gsap as unknown as { registerPlugin: (p: unknown) => void }).registerPlugin($ScrollTrigger)

  // ── 1. Global scroll → Hero3D globe ───────────────────────────
  ;($gsap as unknown as { ScrollTrigger: ScrollTrigger }).ScrollTrigger.create({
    trigger: 'body',
    start: 'top top',
    end: 'bottom bottom',
    onUpdate: (self: { progress: number }) => {
      if (window.netsoGlobeAPI) {
        window.netsoGlobeAPI.setScrollProgress(self.progress)
      }
    },
  })

  // ── 2. Hero canvas entrance ────────────────────────────────────
  $gsap.fromTo(
    '#hero3d-canvas',
    { scale: 0.82, opacity: 0 },
    {
      scale: 1,
      opacity: 1,
      duration: 1.6,
      ease: 'power3.out',
      scrollTrigger: {
        trigger: 'section[id="hero"]',
        start: 'top 80%',
        end: 'top 30%',
        scrub: 1.2,
      },
    }
  )

  // ── 3. Hero text – clip-path slide reveals ─────────────────────
  document.querySelectorAll<HTMLElement>('.hero-reveal').forEach((el, i) => {
    $gsap.fromTo(
      el,
      { clipPath: 'inset(0 100% 0 0)', opacity: 0 },
      {
        clipPath: 'inset(0 0% 0 0)',
        opacity: 1,
        duration: 1.1,
        ease: 'power4.out',
        delay: i * 0.12,
        scrollTrigger: {
          trigger: el,
          start: 'top 85%',
          toggleActions: 'play none none reverse',
        },
      }
    )
  })

  // ── 4. Section headlines – fade + translate ───────────────────
  document.querySelectorAll<HTMLElement>('.section-headline').forEach((el) => {
    $gsap.fromTo(
      el,
      { opacity: 0, y: 40 },
      {
        opacity: 1,
        y: 0,
        duration: 1,
        ease: 'power3.out',
        scrollTrigger: {
          trigger: el,
          start: 'top 82%',
          toggleActions: 'play none none reverse',
        },
      }
    )
  })

  // ── 5. HowItWorks pin (150% of viewport) ──────────────────────
  ;($gsap as unknown as { ScrollTrigger: ScrollTrigger }).ScrollTrigger.create({
    trigger: '#how-it-works',
    start: 'top top',
    end: '+=150%',
    pin: true,
    scrub: 1,
    anticipatePin: 1,
    onEnter: () => window.dispatchEvent(new CustomEvent('netso:globe-split')),
    onLeaveBack: () => window.dispatchEvent(new CustomEvent('netso:globe-merger')),
  })

  // ── 6. Calculator glow activation ─────────────────────────────
  $gsap.fromTo(
    '#savings-calculator',
    { '--glow-opacity': 0 },
    {
      '--glow-opacity': 1,
      duration: 1,
      ease: 'power2.inOut',
      scrollTrigger: {
        trigger: '#savings-calculator',
        start: 'top 65%',
        toggleActions: 'play none none reverse',
      },
    }
  )

  // ── 7. Pricing card stagger entrance ──────────────────────────
  const pricingCards = document.querySelectorAll<HTMLElement>('.pricing-card')
  if (pricingCards.length) {
    $gsap.fromTo(
      pricingCards,
      { opacity: 0, y: 50 },
      {
        opacity: 1,
        y: 0,
        stagger: 0.12,
        duration: 0.8,
        ease: 'power3.out',
        scrollTrigger: {
          trigger: '.pricing-section',
          start: 'top 75%',
          toggleActions: 'play none none reverse',
        },
      }
    )
  }

  // ── 8. Testimonial stagger entrance ───────────────────────────
  const testimonials = document.querySelectorAll<HTMLElement>('.testimonial-card')
  if (testimonials.length) {
    $gsap.fromTo(
      testimonials,
      { opacity: 0, y: 24 },
      {
        opacity: 1,
        y: 0,
        stagger: 0.14,
        duration: 0.7,
        ease: 'power3.out',
        scrollTrigger: {
          trigger: '.testimonials-section',
          start: 'top 80%',
          toggleActions: 'play none none reverse',
        },
      }
    )
  }

  // ── 9. Background ambient shift (HowItWorks) ───────────────────
  ;($gsap as unknown as { ScrollTrigger: ScrollTrigger }).ScrollTrigger.create({
    trigger: '#how-it-works',
    start: 'top 50%',
    end: 'bottom 50%',
    onEnter: () => $gsap.to('body', { backgroundColor: '#080B12', duration: 0.5 }),
    onLeave: () => $gsap.to('body', { backgroundColor: '#0A0D14', duration: 0.8 }),
    onEnterBack: () => $gsap.to('body', { backgroundColor: '#080B12', duration: 0.5 }),
    onLeaveBack: () => $gsap.to('body', { backgroundColor: '#0A0D14', duration: 0.8 }),
  })

  // ── 10. CTA section coronapulse ───────────────────────────────
  ;($gsap as unknown as { ScrollTrigger: ScrollTrigger }).ScrollTrigger.create({
    trigger: '#cta-section',
    start: 'top 60%',
    onEnter: () => window.dispatchEvent(new CustomEvent('netso:cta-enter')),
  })

  // ── 11. Scroll-top gold progress bar glow ──────────────────────
  ;($gsap as unknown as { ScrollTrigger: ScrollTrigger }).ScrollTrigger.create({
    trigger: 'body',
    start: 'top top',
    end: 'bottom bottom',
    onUpdate: (self: { progress: number }) => {
      const pct = self.progress * 100
      const bar = document.querySelector<HTMLElement>('.scroll-progress-fill')
      if (bar) {
        bar.style.width = `${pct}%`
        const intensity = Math.min(pct / 20, 1)
        bar.style.boxShadow = `0 0 ${8 * intensity}px ${2 * intensity}px rgba(${GOLD_RGB}, ${0.3 + intensity * 0.7})`
      }
    },
  })

  ;($gsap as unknown as { ScrollTrigger: ScrollTrigger }).ScrollTrigger.refresh()
}

// ── Cleanup ────────────────────────────────────────────────────────────
export function destroyNetsoScroll(): void {
  const st = $gsap?.ScrollTrigger
  if (st) {
    st.getAll().forEach((t: { kill: () => void }) => t.kill())
  }
}
</file>

