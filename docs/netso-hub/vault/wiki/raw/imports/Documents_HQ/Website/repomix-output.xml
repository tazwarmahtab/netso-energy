/* eslint-disable @typescript-eslint/no-explicit-any */
import { useEffect, useRef, useCallback } from 'react'
import type { RefObject } from 'react'
import { cityNodes, latLngToVector3, energyConnections, getNodeByName } from './nodes'

// ---------------------------------------------------------------------------
// Three.js types — runtime provided by CDN global `window.THREE`;
// type help from @types/three so we get editor IntelliSense
// ---------------------------------------------------------------------------
import type {
  Scene,
  PerspectiveCamera,
  WebGLRenderer,
  MeshStandardMaterial,
  Object3D,
  Points,
  Vector3,
  Group,
  SphereGeometry,
  BufferAttribute,
  AmbientLight,
  DirectionalLight,
  PointLight,
  // Explicit import of DOMHighResTimeStamp for FrameRequestCallback compatibility
} from 'three'

// NOTE: THREE is resolved lazily inside useEffect (not at module init time)
// so that the <script defer> CDN has time to execute before we read window.THREE.

// ---------------------------------------------------------------------------
// Globe API exposed to parent components (and GSAP scroll integration)
// ---------------------------------------------------------------------------
export interface GlobeAPI {
  setScrollProgress: (progress: number) => void
  setMousePosition: (nx: number, ny: number) => void
  getMesh: () => Object3D | null
  setEmissiveIntensity: (intensity: number) => void
  updateParticleSpeed: (speed: number) => void
  dispose: () => void
}

// ---------------------------------------------------------------------------
// Constants
// ---------------------------------------------------------------------------
const GLOBE_RADIUS = 2.2
const BASE_PARTICLE_SPEED = 1.5
const SOLAR_GOLD = 0xf59e0b

// ---------------------------------------------------------------------------
// Main hook
// ---------------------------------------------------------------------------
export function useGlobeScene(
  canvasRef: RefObject<HTMLCanvasElement | null>
): GlobeAPI {
  const sceneRef = useRef<Scene | null>(null)
  const cameraRef = useRef<PerspectiveCamera | null>(null)
  const rendererRef = useRef<WebGLRenderer | null>(null)
  // Use a plain object instead of useRef<T> to avoid TypeScript 5.9 incorrectly
  // narrowing RefObject<T>.current to () => void in strict mode.
  const frameRef: { current: number } = { current: 0 }
  const globeGroupRef = useRef<Group | null>(null)
  const nodesRef = useRef<Object3D[]>([])
  const scrollProgressRef = useRef(0)
  const mouseRef = useRef({ x: 0, y: 0 })
  const targetMouseRef = useRef({ x: 0, y: 0 })
  const rotationSpeedRef = useRef(0.002)
  const particleSpeedRef = useRef(BASE_PARTICLE_SPEED)
  const emissiveIntensityRef = useRef(0.4)
  const globeMaterialRef = useRef<MeshStandardMaterial | null>(null)

  // Particle flows tracked for animation loop
  const particleFlowsRef = useRef<
    { positions: Vector3[]; progress: number[]; pointsObj: Points; posAttr: BufferAttribute }[]
  >([])

  // ------------------------------------------------------------------
  // Scene initialisation
  // ------------------------------------------------------------------
  useEffect(() => {
    const canvas = canvasRef.current
    if (!canvas) return

    // Resolve THREE at effect time (not module-load time) so that the
    // <script defer> CDN has had a chance to run.
    const THREE = (window as any).THREE
    if (!THREE) {
      console.warn('[Hero3D] THREE.js not yet on window — retrying in 200ms')
      // Retry once when THREE finally loads.
      const tid = setTimeout(() => {
        const r = (window as any).THREE
        if (r) initGlobe(r, canvas)
      }, 200)
      return () => clearTimeout(tid)
    }

    initGlobe(THREE, canvas)

    function initGlobe(THREE: any, canvas: HTMLCanvasElement) {
      // Guard against 0×0 canvas at startup; a 1×1 renderer still renders fine.
      const w = canvas.clientWidth || 1
      const h = canvas.clientHeight || 1

      // Renderer
      const renderer = new THREE.WebGLRenderer({ canvas, antialias: true, alpha: true })
      renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2))
      renderer.setSize(w, h)
      renderer.toneMapping = THREE.ACESFilmicToneMapping ?? 4
      renderer.toneMappingExposure = 1.2
      rendererRef.current = renderer

      // Scene
      const scene = new THREE.Scene()
      sceneRef.current = scene

      // Camera
      const camera = new THREE.PerspectiveCamera(45, w / h, 0.1, 100)
      camera.position.z = 6.5
      cameraRef.current = camera

      // ── Globe group ──────────────────────────────────────────────────
      const globeGroup = new THREE.Group()
      scene.add(globeGroup)
      globeGroupRef.current = globeGroup

      // ── Dark sphere (globe body) ────────────────────────────────────
      const sphereGeo = new THREE.SphereGeometry(GLOBE_RADIUS, 64, 64)
      const sphereMat = new THREE.MeshStandardMaterial({
        color: 0x0d1117,
        emissive: 0x0a0d14,
        emissiveIntensity: 0.4,
        roughness: 0.85,
        metalness: 0.15,
      })
      globeMaterialRef.current = sphereMat
      const sphere = new THREE.Mesh(sphereGeo, sphereMat)
      globeGroup.add(sphere)

      // ── Wireframe latitude/longitude lines ────────────────────────
      const wireGeo = new THREE.SphereGeometry(GLOBE_RADIUS * 1.002, 36, 18)
      const wireEdges = new THREE.EdgesGeometry(wireGeo)
      const wireMat = new THREE.LineBasicMaterial({ color: 0x1a2030, transparent: true, opacity: 0.35 })
      const wireframe = new THREE.LineSegments(wireEdges, wireMat)
      globeGroup.add(wireframe)

      // ── Outer atmosphere glow layers ───────────────────────────────
      const atmLayers: [number, number, number][] = [
        [GLOBE_RADIUS * 1.09, 0x1a3050, 0.07],
        [GLOBE_RADIUS * 1.19, 0x0a2040, 0.04],
        [GLOBE_RADIUS * 1.29, 0x040810, 0.02],
      ]
      atmLayers.forEach(([r, color, opacity]) => {
        const geo = new THREE.SphereGeometry(r, 32, 32) as SphereGeometry
        const mat = new (THREE.MeshBasicMaterial as any)({ color, transparent: true, opacity })
        const mesh = new THREE.Mesh(geo, mat)
        globeGroup.add(mesh)
      })

      // ── City energy nodes ──────────────────────────────────────────
      const nodeMeshes: Object3D[] = []
      cityNodes.forEach((city) => {
        const pos = latLngToVector3(city.lat, city.lng, GLOBE_RADIUS)

        const nodeGeo = new THREE.SphereGeometry(0.045 * city.size, 16, 16)
        const nodeMat = new THREE.MeshStandardMaterial({
          color: SOLAR_GOLD,
          emissive: SOLAR_GOLD,
          emissiveIntensity: city.isPrimary ? 2.2 : 1.4,
          roughness: 0,
          metalness: 0,
        })
        const nodeMesh = new THREE.Mesh(nodeGeo, nodeMat)
        nodeMesh.position.set(pos.x, pos.y, pos.z)
        globeGroup.add(nodeMesh)
        nodeMeshes.push(nodeMesh)

        // Solar corona halo for Dhaka
        if (city.isPrimary) {
          const haloGeo = new THREE.SphereGeometry(0.11, 16, 16)
          const haloMat = new THREE.MeshBasicMaterial({ color: SOLAR_GOLD, transparent: true, opacity: 0.2 })
          const halo = new THREE.Mesh(haloGeo, haloMat)
          halo.position.set(pos.x, pos.y, pos.z)
          globeGroup.add(halo)
        }
      })
      nodesRef.current = nodeMeshes

      // ── Energy connection lines + flowing particles ───────────────
      const particleFlows: typeof particleFlowsRef.current = []

      energyConnections.forEach(([from, to]) => {
        const fromNode = getNodeByName(from)
        const toNode = getNodeByName(to)
        if (!fromNode || !toNode) return

        const fromPos = latLngToVector3(fromNode.lat, fromNode.lng, GLOBE_RADIUS)
        const toPos = latLngToVector3(toNode.lat, toNode.lng, GLOBE_RADIUS)

        const start = new THREE.Vector3(fromPos.x, fromPos.y, fromPos.z)
        const end = new THREE.Vector3(toPos.x, toPos.y, toPos.z)

        // Static connection line
        const linePoints: Vector3[] = []
        for (let i = 0; i <= 32; i++) {
          linePoints.push(new THREE.Vector3().lerpVectors(start, end, i / 32))
        }
        const lineGeo = new THREE.BufferGeometry().setFromPoints(linePoints)
        const lineMat = new THREE.LineBasicMaterial({ color: SOLAR_GOLD, transparent: true, opacity: 0.15 })
        globeGroup.add(new THREE.Line(lineGeo, lineMat))

        // Flowing particle points (8 per connection)
        const particleCount = 8
        const particleProgress: number[] = Array.from({ length: particleCount }, (_, i) => i / particleCount)
        const particlePositions = new Float32Array(particleCount * 3)
        const particleGeo = new THREE.BufferGeometry()
        const posAttr = new THREE.BufferAttribute(particlePositions, 3)
        particleGeo.setAttribute('position', posAttr)

        const particleMat = new THREE.PointsMaterial({
          color: SOLAR_GOLD,
          size: 0.055,
          sizeAttenuation: true,
          transparent: true,
          opacity: 0.9,
        })
        const pointsObj = new THREE.Points(particleGeo, particleMat)
        globeGroup.add(pointsObj)

        // Initialise particle positions
        for (let i = 0; i < particleCount; i++) {
          const p = new THREE.Vector3().lerpVectors(start, end, particleProgress[i])
          particlePositions[i * 3] = p.x
          particlePositions[i * 3 + 1] = p.y
          particlePositions[i * 3 + 2] = p.z
        }
        posAttr.needsUpdate = true

        particleFlows.push({ positions: [start, end], progress: particleProgress, pointsObj, posAttr })
      })

      particleFlowsRef.current = particleFlows

      // ── Lighting ───────────────────────────────────────────────────
      const ambient = new THREE.AmbientLight(0x112233, 0.8) as AmbientLight
      scene.add(ambient)

      const sunLight = new THREE.DirectionalLight(0xfff5d0, 2.5) as DirectionalLight
      sunLight.position.set(5, 8, 6)
      scene.add(sunLight)

      const rimLight = new THREE.DirectionalLight(0x2040a0, 0.5) as DirectionalLight
      rimLight.position.set(-6, -2, -5)
      scene.add(rimLight)

      // Gold point light from Dhaka location
      const dhakaPos = latLngToVector3(23.8103, 90.4125, GLOBE_RADIUS + 0.15)
      const pointLight = new THREE.PointLight(SOLAR_GOLD, 1.4, 3) as PointLight
      pointLight.position.set(dhakaPos.x, dhakaPos.y, dhakaPos.z)
      globeGroup.add(pointLight)

      // ── Resize observer ─────────────────────────────────────────────
      const ro = new ResizeObserver(() => {
        if (!camera || !renderer) return
        const rw = canvas.clientWidth || 1
        const rh = canvas.clientHeight || 1
        renderer.setSize(rw, rh, false)
        camera.aspect = rw / rh
        camera.updateProjectionMatrix()
      })
      if (canvas.parentElement) ro.observe(canvas.parentElement)

      // ── Render loop ─────────────────────────────────────────────────
      let lastTime = performance.now()

      const animate = (time: number): void => {
        frameRef.current = requestAnimationFrame(animate) as unknown as number
        const delta = Math.min((time - lastTime) / 1000, 0.05)
        lastTime = time

        // Smooth mouse for parallax
        const mx = mouseRef.current.x + (targetMouseRef.current.x - mouseRef.current.x) * 0.04
        const my = mouseRef.current.y + (targetMouseRef.current.y - mouseRef.current.y) * 0.04
        mouseRef.current = { x: mx, y: my }

        // Globe auto-rotation + mouse tilt
        globeGroup.rotation.y += rotationSpeedRef.current * (1 + scrollProgressRef.current * 3.5)
        globeGroup.rotation.x += (my * 0.22 - globeGroup.rotation.x) * 0.04
        ;(globeGroup as any).rotation.z += (-mx * 0.12 - (globeGroup as any).rotation.z) * 0.04

        // Scroll-driven glow intensity
        if (globeMaterialRef.current) {
          const boost = 0.4 + scrollProgressRef.current * 1.4
          globeMaterialRef.current.emissiveIntensity = emissiveIntensityRef.current * boost
        }

        // Animate flowing particles along connection lines
        const pSpeed = particleSpeedRef.current * (1 + scrollProgressRef.current * 4)

        particleFlows.forEach((flow) => {
          flow.progress.forEach((prog, i) => {
            prog += delta * pSpeed * (0.25 + i * 0.07)
            if (prog > 1) prog -= 1
            flow.progress[i] = prog
          })

          for (let i = 0; i < flow.progress.length; i++) {
            const p = new THREE.Vector3().lerpVectors(flow.positions[0], flow.positions[1], flow.progress[i])
            flow.posAttr.setXYZ(i, p.x, p.y, p.z)
          }
          flow.posAttr.needsUpdate = true
        })

        renderer.render(scene, camera)
      }

      frameRef.current = requestAnimationFrame(animate) as unknown as number

      // ── Cleanup ─────────────────────────────────────────────────────
      // Store on canvas so the outer cleanup can find it if initGlobe ran.
      (canvas as any)._disposeGlobe = () => {
        cancelAnimationFrame(frameRef.current)
        ro.disconnect()
        sphereGeo.dispose()
        sphereMat.dispose()
        wireGeo.dispose()
        wireMat.dispose()
        renderer.dispose()
      }
    }

    // Outer cleanup: safe whether or not initGlobe has been called yet.
    return () => {
      if (canvas && (canvas as any)._disposeGlobe) {
        ;(canvas as any)._disposeGlobe()
        ;(canvas as any)._disposeGlobe = undefined
      }
    }
    // eslint-disable-next-line react-hooks/exhaustive-deps
  }, [])

  // ------------------------------------------------------------------
  // Imperative API (called from parent / GSAP scroll)
  // ------------------------------------------------------------------
  const setScrollProgress = useCallback((progress: number) => {
    scrollProgressRef.current = progress
  }, [])

  const setMousePosition = useCallback((nx: number, ny: number) => {
    targetMouseRef.current = { x: nx, y: ny }
  }, [])

  const setEmissiveIntensity = useCallback((intensity: number) => {
    emissiveIntensityRef.current = intensity
  }, [])

  const updateParticleSpeed = useCallback((speed: number) => {
    particleSpeedRef.current = speed
  }, [])

  const dispose = useCallback(() => {
    cancelAnimationFrame(frameRef.current)
    rendererRef.current?.dispose()
  }, [])

  return {
    setScrollProgress,
    setMousePosition,
    getMesh: () => globeGroupRef.current,
    setEmissiveIntensity,
    updateParticleSpeed,
    dispose,
  }
}
