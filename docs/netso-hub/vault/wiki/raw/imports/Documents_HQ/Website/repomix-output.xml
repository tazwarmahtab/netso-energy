            >
              <Zap size={20} className="text-black" fill="currentColor" />
            </motion.div>
            <span className="text-2xl font-bold text-white tracking-tight">NETSO</span>
          </motion.a>

          {/* Desktop Navigation */}
          <div className="hidden md:flex items-center gap-1">
            {menuLinks.map((link, i) => (
              <motion.a
                key={link.name}
                href={link.href}
                className="text-sm font-medium text-gray-400 hover:text-white px-4 py-2 transition-colors relative group"
                initial={{ opacity: 0, y: -10 }}
                animate={{ opacity: 1, y: 0 }}
