        <meshStandardMaterial color="#4b5563" roughness={0.4} metalness={0.6} />
      </mesh>
      {/* Solar Panels */}
      <SolarPanel position={[0, 0.2, 0]} />
      <SolarPanel position={[0, 0.2, -0.7]} />
      <SolarPanel position={[0, 0.2, 0.7]} />
    </group>
  )
}

// Stats Card
function StatsCard({ icon, label, value, subtext, delay }: { icon: React.ReactNode, label: string, value: string, subtext: string, delay: number }) {
