// Lat/long coordinates for major Bangladesh cities + key solar markets
// Used to position golden energy nodes on the 3D globe

export interface CityNode {
  name: string
  lat: number
  lng: number
  label: string
  size: number // relative node size
  isPrimary?: boolean // Dhaka — largest node
}

// Convert lat/lng to 3D sphere position (Three.js coordinate system)
// Three.js sphere: x=cos(lat)*cos(lng), y=sin(lat), z=cos(lat)*sin(lng)
// Note: Three.js Y is up; we treat lat as Y axis
export function latLngToVector3(lat: number, lng: number, radius: number) {
  const phi = (90 - lat) * (Math.PI / 180) // polar angle (0=top, 90=equator)
  const theta = (lng + 180) * (Math.PI / 180) // azimuth

  return {
    x: -(radius * Math.sin(phi) * Math.cos(theta)),
    y: radius * Math.cos(phi),
    z: radius * Math.sin(phi) * Math.sin(theta),
  }
}

export const cityNodes: CityNode[] = [
  // Primary node: Dhaka (capital, largest solar market)
  {
    name: 'Dhaka',
    lat: 23.8103,
