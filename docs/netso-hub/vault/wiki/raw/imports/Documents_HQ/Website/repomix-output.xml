/**
 * App.tsx — Netso Website
 * SolarHero = unified hero + designed-for-BD assembly scene.
 * All other sections render normally after it.
 */
import { useEffect, useState } from 'react'
import Navbar from './components/Navbar'
import SolarHero from './components/SolarHero/SolarHero'
import ComplianceBar from './components/ComplianceBar'
import RooftopLounge from './components/RooftopLounge'
import HowItWorks from './components/HowItWorks'
import AggregationSection from './components/AggregationSection'
import IndustrialSolution from './components/IndustrialSolution'
import Solutions from './components/Solutions'
import SavingsCalculator from './components/SavingsCalculator'
import RecentInstallations from './components/RecentInstallations'
import SmartMonitoring from './components/SmartMonitoring'
import Pricing from './components/Pricing'
import SmartStorage from './components/SmartStorage'
import PassiveIncome from './components/PassiveIncome'
import PartnerProgram from './components/PartnerProgram'
import { ReactLenis } from 'lenis/react'

// ── Custom Cursor ─────────────────────────────────────────────────────────
function CustomCursor() {
  const [pos, setPos] = useState({ x: 0, y: 0 })
  const [hover, setHover] = useState(false)

  useEffect(() => {
    const move = (e: MouseEvent) => {
      setPos({ x: e.clientX, y: e.clientY })
      const t = e.target as HTMLElement
      setHover(!!(t.closest('a') || t.closest('button')))
    }
    window.addEventListener('mousemove', move)
    return () => window.removeEventListener('mousemove', move)
  }, [])

  return (
    <div
      className="custom-cursor hidden md:block"
      style={{
        left: pos.x - 6,
        top: pos.y - 6,
        transform: hover ? 'scale(3)' : 'scale(1)',
      }}
    />
  )
}

// ── Scroll Progress Bar ───────────────────────────────────────────────────
function ScrollProgress() {
  const [pct, setPct] = useState(0)
  useEffect(() => {
    const fn = () => {
      const total = document.documentElement.scrollHeight - window.innerHeight
      setPct(total > 0 ? (window.scrollY / total) * 100 : 0)
    }
    window.addEventListener('scroll', fn, { passive: true })
    return () => window.removeEventListener('scroll', fn)
  }, [])
  return (
    <div className="fixed top-0 left-0 w-full h-0.5 z-[9999]">
      <div
        className="scroll-progress-fill h-full bg-gradient-to-r from-solar-gold to-solar-amber"
        style={{ width: `${pct}%` }}
      />
    </div>
  )
}

// ── App ───────────────────────────────────────────────────────────────────
export default function App() {
  // Wire GSAP scroll cinema once the globe is ready
  useEffect(() => {
    function onGlobeReady(e: Event) {
      const { globe } = (e as CustomEvent).detail as { globe?: unknown }
      if (globe && typeof window !== 'undefined') {
        ;(window as unknown as { netsoGlobeAPI: unknown }).netsoGlobeAPI = globe as object
      }
      import('./lib/gsap-scroll').then(({ initNetsoScroll }) => setTimeout(initNetsoScroll, 300))
    }
    window.addEventListener('netso:globe ready', onGlobeReady)
    return () => window.removeEventListener('netso:globe ready', onGlobeReady)
  }, [])

  return (
    <ReactLenis root>
      <CustomCursor />
      <ScrollProgress />
      <div className="bg-[#0A0D14] min-h-screen">
        <Navbar />
        <SolarHero />
        <ComplianceBar />
        <RooftopLounge />
        <HowItWorks />
        <AggregationSection />
        <IndustrialSolution />
        <Solutions />
        <SavingsCalculator />
        <RecentInstallations />
        <SmartMonitoring />
        <Pricing />
        <SmartStorage />
        <PassiveIncome />
        <PartnerProgram />
      </div>
    </ReactLenis>
  )
}
</file>

