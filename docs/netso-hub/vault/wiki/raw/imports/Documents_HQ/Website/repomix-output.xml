    --border: oklch(1 0 0 / 10%);
    --input: oklch(1 0 0 / 15%);
    --ring: oklch(0.556 0 0);
    --chart-1: oklch(0.87 0 0);
    --chart-2: oklch(0.556 0 0);
    --chart-3: oklch(0.439 0 0);
    --chart-4: oklch(0.371 0 0);
    --chart-5: oklch(0.269 0 0);
    --sidebar: oklch(0.205 0 0);
    --sidebar-foreground: oklch(0.985 0 0);
    --sidebar-primary: oklch(0.488 0.243 264.376);
    --sidebar-primary-foreground: oklch(0.985 0 0);
    --sidebar-accent: oklch(0.269 0 0);
    --sidebar-accent-foreground: oklch(0.985 0 0);
    --sidebar-border: oklch(1 0 0 / 10%);
    --sidebar-ring: oklch(0.556 0 0);
  }
  * {
    @apply border-border outline-ring/50;
  }
  html {
    @apply font-sans;
  }
}

@layer components {
  /* Glass Card */
  .glass-card {
    background: var(--glass-bg);
    backdrop-filter: blur(var(--glass-blur));
    border: 1px solid var(--glass-border);
    border-radius: 1.5rem;
  }
}

@layer utilities {
  /* Gradient text */
  .gradient-text {
    background: linear-gradient(135deg, var(--color-solar-gold), var(--color-solar-amber));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }
}

/* Scroll Progress Bar */
.scroll-progress {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 2px;
  background: transparent;
  z-index: 9999;
}

.scroll-progress-bar {
  height: 100%;
  background: linear-gradient(90deg, var(--color-solar-gold), var(--color-solar-amber));
  width: var(--progress, 0%);
  transition: width 0.1s var(--ease-out);
}

/* Custom Cursor */
.custom-cursor {
  position: fixed;
  top: 0;
  left: 0;
  width: 12px;
  height: 12px;
  border-radius: 50%;
  background: var(--color-solar-gold);
  pointer-events: none;
  z-index: 9999;
  mix-blend-mode: difference;
  transition: transform 0.1s var(--ease-out);
}

.custom-cursor.cursor-hover {
  transform: scale(3);
  background: rgba(245, 158, 11, 0.3);
  backdrop-filter: blur(0.5rem);
}

.custom-cursor.cursor-click {
  transform: scale(0.8);
}

@media (max-width: 768px) {
  .custom-cursor {
    display: none;
  }
}

/* Scroll indicator animation */
.scroll-indicator {
  animation: scroll-bounce 2s infinite;
}

@keyframes scroll-bounce {
  0%, 100% {
    transform: translateY(0);
  }
  50% {
    transform: translateY(8px);
  }
}

/* Text reveal animation */
.text-reveal {
  clip-path: inset(0 100% 0 0);
  animation: text-reveal-animation 1s var(--ease-dramatic) forwards;
}

@keyframes text-reveal-animation {
  to {
    clip-path: inset(0 0 0 0);
  }
}

/* Custom Scrollbar */
@media (hover: hover) {
  ::-webkit-scrollbar {
    width: 8px;
  }

  ::-webkit-scrollbar-track {
    background: var(--color-night);
  }

  ::-webkit-scrollbar-thumb {
    background: var(--color-steel);
    border-radius: 4px;
  }

  ::-webkit-scrollbar-thumb:hover {
    background: var(--color-mist);
  }
}

/* Hero video — full-bleed cinematic backdrop */
.hero-video {
  transition: transform 0.05s linear;
  /* Prevent any margin collapse or reflow during scroll */
  display: block;
}

@media (prefers-reduced-motion: reduce) {
  .hero-video {
    transform: none !important;
  }
}

/* Selection */
::selection {
  background-color: var(--color-solar-gold);
  color: var(--color-night);
}
