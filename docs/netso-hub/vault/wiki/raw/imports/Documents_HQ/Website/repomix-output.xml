}

// Simple Pergola
function SolarPergola() {
  return (
    <group>
      {/* Support Columns */}
      {[[-1.5, -1.5, -1.5], [1.5, -1.5, -1.5], [-1.5, -1.5, 1.5], [1.5, -1.5, 1.5]].map((pos, i) => (
        <mesh key={i} position={pos as [number, number, number]}>
          <cylinderGeometry args={[0.08, 0.08, 3, 8]} />
          <meshStandardMaterial color="#374151" roughness={0.4} metalness={0.6} />
        </mesh>
      ))}
      {/* Roof Beams */}
      <mesh position={[0, -0.1, -1.5]} rotation={[0, 0, Math.PI / 2]}>
        <cylinderGeometry args={[0.1, 0.1, 3.5, 8]} />
        <meshStandardMaterial color="#4b5563" roughness={0.4} metalness={0.6} />
      </mesh>
      <mesh position={[0, -0.1, 1.5]} rotation={[0, 0, Math.PI / 2]}>
