function SolarPanel({
  visible,
  cx, cy, rx, ry,
}: {
  visible: boolean
  cx: number
  cy: number
  rx: number
  ry: number
}) {
  if (!visible) return null
  return (
    <g className="solar-panel-group" transform={`rotate(-14, ${cx}, ${cy})`}>
      {/* Frame */}
      <rect
        x={cx - rx} y={cy - ry}
        width={rx * 2} height={ry * 2}
        rx="3.5" fill="#0f172a" stroke="#374151" strokeWidth="1.5"
      />
      {/* Cell surface */}
      <rect
        x={cx - rx + 2.5} y={cy - ry + 2.5}
        width={rx * 2 - 5} height={ry * 2 - 5}
        rx="2" fill="url(#panel-fill)"
      />
      {/* Grid lines — vertical */}
      {[cx - rx * 0.33, cx, cx + rx * 0.33].map((gx, i) => (
        <line key={i} x1={gx} y1={cy - ry + 2.5} x2={gx} y2={cy + ry - 2.5}
          stroke="#0f172a" strokeWidth="0.9" opacity="0.55" />
      ))}
      {/* Grid lines — horizontal */}
      {[cy - ry * 0.33, cy, cy + ry * 0.33].map((gy, i) => (
        <line key={i} x1={cx - rx + 2.5} y1={gy} x2={cx + rx - 2.5} y2={gy}
          stroke="#0f172a" strokeWidth="0.9" opacity="0.55" />
      ))}
      {/* Diagonal sheen */}
      <rect
        x={cx - rx + 2.5} y={cy - ry + 2.5}
        width={(rx * 2 - 5) * 0.55} height={(ry * 2 - 5) * 0.4}
        rx="1" fill="url(#panel-sheen)" opacity="0.6"
      />
      {/* Corner mounting bolts */}
      {[
        [cx - rx + 5, cy - ry + 5],
        [cx + rx - 5, cy - ry + 5],
        [cx - rx + 5, cy + ry - 5],
        [cx + rx - 5, cy + ry - 5],
      ].map(([bx, by], i) => (
        <circle key={i} cx={bx} cy={by} r={2.8} fill="#4b5563" />
      ))}
    </g>
  )
}

