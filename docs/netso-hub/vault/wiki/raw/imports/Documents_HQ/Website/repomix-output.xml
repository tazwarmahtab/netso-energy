/**
 * SolarHero.tsx
 * Unified hero + designed-for-Bangladesh assembly scene.
 *
 * Scroll journey (200vh section):
 *  0–10%  : Nothing assembles yet, hero text prominent
 *  10–27% : Concrete pads snap in
 *  27–42% : Steel posts drop into pads
 *  42–57% : Cross beam + rafters materialise, NETSO label appears
 *  57–87% : Three solar panels drop in with staggered bounce
 *  87–100%: Inverter + wiring, "Designed for Bangladesh" fades in
 *
 * Text overlays:
 *  Hero text → fades out  at progress 0.15 → 0.55
 *  Bangladesh  → fades in   at progress 0.72 → 1.00
 */

import { useRef, useState } from 'react'
import { motion, useScroll, useTransform, useMotionValueEvent } from 'framer-motion'
import SolarPergola from './SolarPergola'

// ── Stats (shown at lower-left of scene, fade with hero text) ──────────────
const stats = [
  { value: '3.5–10 kW', label: 'System Sizes' },
  { value: '25 yrs',    label: 'Performance Warranty' },
  { value: '100%',      label: 'Bill Offset Available' },
  { value: 'SREDA',     label: 'Certified Installers' },
]

export default function SolarHero() {
  const sectionRef = useRef<HTMLDivElement>(null)

  const { scrollYProgress } = useScroll({
    target: sectionRef,
    offset: ['start start', 'end end'],
  })

  // ── Assembly progress (0 → 1 over the whole section) ────────────────────
  const assemblyProgress = useTransform(scrollYProgress, [0, 1], [0, 1])
  // MotionValue → state so SolarPergola re-renders on scroll
  const [assemblyValue, setAssemblyValue] = useState(0)
  useMotionValueEvent(assemblyProgress, 'change', (v) => setAssemblyValue(v))

  // ── Hero text: fade out in the first half of scroll ─────────────────────
  const heroTextOpacity = useTransform(scrollYProgress, [0.12, 0.52], [1, 0])
  const heroTextY       = useTransform(scrollYProgress, [0.12, 0.48], [0, -30])

  // ── "Designed for Bangladesh" text: fades in second half ────────────────
  const bdTextOpacity = useTransform(scrollYProgress, [0.70, 0.98], [0, 1])
  const bdTextY       = useTransform(scrollYProgress, [0.66, 0.92], [24, 0])

  // ── Scroll indicator: fade in/out ───────────────────────────────────────
  const scrollIndicatorOpacity = useTransform(
    scrollYProgress,
    [0, 0.05, 0.12, 0.20],
    [0, 1, 1, 0]
  )

  // ── Scene parallax: background drifts upward on scroll ──────────────────
  const bgY = useTransform(scrollYProgress, [0, 1], ['0%', '5%'])

  return (
    <div ref={sectionRef} className="relative" style={{ height: '200vh' }}>

      {/* ── Sticky viewport container ────────────────────────────────── */}
      <div className="sticky top-0 h-screen overflow-hidden">

        {/* Video backdrop */}
        <motion.div
          className="absolute inset-0 overflow-hidden pointer-events-none"
          style={{ y: bgY, zIndex: 1 }}
          aria-hidden="true"
        >
          <video
            autoPlay
            muted
            loop
            playsInline
            disablePictureInPicture
            className="hero-video"
            style={{
              position: 'absolute',
              inset: '-10% 0',
              width: '100%',
              height: '120%',
              objectFit: 'cover',
              objectPosition: 'center',
              filter: 'saturate(0.5) contrast(1.1) brightness(0.35)',
            }}
          >
            <source src="/assets/hero-video.mp4" type="video/mp4" />
          </video>

          {/* Deep dark overlay — ensures rooftop scene reads clearly */}
          <div
            className="absolute inset-0"
            style={{ background: 'rgba(6,10,16,0.76)', zIndex: 1 }}
          />
          {/* Bottom-heavy fade to dark — hides video bottom, shows text/assembly */}
          <div
            className="absolute inset-0"
