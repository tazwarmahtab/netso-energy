import { useRef, useEffect, useCallback } from 'react'
import { motion } from 'framer-motion'
import { ArrowRight } from 'lucide-react'
import { useGlobeScene } from './useGlobeScene'

// Detect mobile (Three.js heavy on mobile CPUs)
function isMobile(): boolean {
  return /Mobi|Android|iPhone|iPad/i.test(navigator.userAgent)
}

// ── Static CSS-based globe fallback ───────────────────────────────────────
function StaticGlobe() {
  return (
    <>
      {/* Outer atmosphere rings */}
      {[1.1, 1.2, 1.32].map((scale, i) => (
        <div
          key={i}
          className="absolute rounded-full animate-pulse"
          style={{
            inset: 0,
            transform: `scale(${scale})`,
            border: `1px solid rgba(245,158,11,${0.06 - i * 0.015})`,
            animationDelay: `${i * 0.8}s`,
            animationDuration: `${3 + i}s`,
          }}
        />
      ))}

      {/* Core dark sphere */}
      <div
        className="absolute inset-0 rounded-full"
        style={{
          background:
            'radial-gradient(circle at 38% 35%, #1e2d42 0%, #0d1117 55%, #060a10 100%)',
          boxShadow: `
            0 0 80px 15px rgba(245,158,11,0.12),
            0 0 160px 40px rgba(245,158,11,0.05),
            inset 0 0 60px rgba(0,0,0,0.6)
          `,
        }}
      />

      {/* Dhaka — primary node */}
      <div
        className="absolute rounded-full animate-pulse"
        style={{
          width: 10,
          height: 10,
          background: '#F59E0B',
          top: '50%',
          left: '58%',
          boxShadow:
            '0 0 10px 4px rgba(245,158,11,0.8), 0 0 30px 8px rgba(245,158,11,0.3)',
          animationDuration: '2s',
        }}
      />

      {/* Chattogram */}
      <div
        className="absolute rounded-full"
        style={{
          width: 7,
          height: 7,
          background: '#F59E0B',
          top: '61%',
          left: '63%',
          opacity: 0.85,
          boxShadow: '0 0 6px 2px rgba(245,158,11,0.6)',
        }}
      />

      {/* Khulna */}
      <div
        className="absolute rounded-full"
        style={{
          width: 6,
          height: 6,
          background: '#F59E0B',
          top: '56%',
          left: '46%',
          opacity: 0.75,
          boxShadow: '0 0 5px 2px rgba(245,158,11,0.5)',
        }}
      />

      {/* Rajshahi */}
      <div
        className="absolute rounded-full"
        style={{
          width: 5,
          height: 5,
          background: '#F59E0B',
          top: '38%',
          left: '52%',
          opacity: 0.65,
          boxShadow: '0 0 4px 2px rgba(245,158,11,0.4)',
        }}
      />

      {/* Sylhet */}
      <div
        className="absolute rounded-full"
        style={{
          width: 4,
          height: 4,
          background: '#F59E0B',
          top: '36%',
          left: '70%',
          opacity: 0.55,
        }}
      />

      {/* Rangpur */}
      <div
        className="absolute rounded-full"
        style={{
          width: 4,
          height: 4,
          background: '#F59E0B',
          top: '29%',
          left: '55%',
          opacity: 0.5,
        }}
      />
    </>
  )
}

// ── Stats data ────────────────────────────────────────────────────────────
const stats = [
  { value: '12.4 kWh', label: 'Daily Generation', sub: 'Per 3kW system' },
  { value: '৳5,400', label: 'Monthly Savings', sub: 'Bill reduction' },
  { value: '5.9 yrs', label: 'Payback Period', sub: 'With net metering' },
  { value: '4.2 tons', label: 'CO₂ Offset', sub: 'Per year' },
]

// ── Main component ────────────────────────────────────────────────────────
export default function Hero3D() {
  const canvasRef = useRef<HTMLCanvasElement>(null)
  const videoRef = useRef<HTMLVideoElement>(null)
  const mobile = isMobile()

  // Three.js globe scene
  const globe = useGlobeScene(canvasRef)

  // ── Scroll → parallax offset on video ──────────────────────────
  const handleScroll = useCallback(
    (_e: Event) => {
      const scrollTotal =
        document.documentElement.scrollHeight - window.innerHeight
      const progress = scrollTotal > 0 ? window.scrollY / scrollTotal : 0
      if (videoRef.current) {
        // Video drifts upward 80px over the full page scroll
        videoRef.current.style.transform = `translateY(${progress * -80}px) scale(1.06)`
      }
      globe.setScrollProgress(progress)
    },
    [globe]
  )

  // ── Mouse parallax → subtle globe tilt ─────────────────────────
  const handleMouseMove = useCallback(
    (e: MouseEvent) => {
      if (mobile) return
      const nx = (e.clientX / window.innerWidth) * 2 - 1
      const ny = -(e.clientY / window.innerHeight) * 2 + 1
      globe.setMousePosition(nx, ny)
    },
    [globe, mobile]
  )

  useEffect(() => {
    window.addEventListener('mousemove', handleMouseMove)
    window.addEventListener('scroll', handleScroll, { passive: true })
    return () => {
      window.removeEventListener('mousemove', handleMouseMove)
      window.removeEventListener('scroll', handleScroll)
    }
  }, [handleMouseMove, handleScroll])

  // Expose globe ref via custom event so gsap-scroll.ts can hook in
  useEffect(() => {
    window.dispatchEvent(
      new CustomEvent('netso:globe ready', { detail: { globe } })
    )
    return () => {
      window.dispatchEvent(new CustomEvent('netso:globe dispose'))
      globe.dispose()
    }
  }, [globe])

  // ── Render ──────────────────────────────────────────────────────
  return (
    <section
      id="hero"
      className="relative min-h-screen overflow-hidden"
      style={{ background: '#060a10' }}
    >
      {/* ── Hero video backdrop ─────────────────────────────── */}
      <div
        className="absolute inset-0 overflow-hidden"
        style={{ zIndex: 1, pointerEvents: 'none' }}
      >
        <video
          ref={videoRef}
          className="hero-video"
          autoPlay
          muted
          loop
          playsInline
          disablePictureInPicture
          style={{
            position: 'absolute',
            inset: '-8% 0',          // extra vertical space for parallax travel
            width: '100%',
            height: '116%',
            objectFit: 'cover',
            objectPosition: 'center',
            transform: 'translateY(0) scale(1.06)',
            willChange: 'transform',
            // Cinematic color grade
            filter: 'saturate(0.65) contrast(1.08) brightness(0.62)',
          }}
        >
          <source src="/assets/hero-video.mp4" type="video/mp4" />
        </video>

        {/* Multi-layer dark overlay — left/right vignette + bottom fade */}
        {/* Bottom section fade */}
        <div
          aria-hidden="true"
          className="absolute inset-0"
          style={{
            background:
              'linear-gradient(to bottom, rgba(6,10,16,0.72) 0%, rgba(6,10,16,0) 30%, rgba(6,10,16,0) 55%, rgba(6,10,16,0.92) 100%)',
            zIndex: 2,
          }}
        />
        {/* Radial centre-light restore — keeps globe readable */}
        <div
          aria-hidden="true"
          className="absolute inset-0"
          style={{
            background:
              'radial-gradient(ellipse 70% 65% at 50% 45%, rgba(6,10,16,0) 0%, rgba(6,10,16,0.5) 100%)',
            zIndex: 2,
          }}
        />
        {/* Top bar fade (navbar transition) */}
        <div
          aria-hidden="true"
          className="absolute inset-0"
          style={{
            background:
              'linear-gradient(to bottom, rgba(6,10,16,0.6) 0%, rgba(6,10,16,0) 12%)',
            zIndex: 2,
          }}
        />
      </div>

      {/* ── Globe canvas / static fallback ─────────────────── */}
      <div
        className="absolute inset-0 flex items-center justify-center pointer-events-none"
        style={{ zIndex: 3 }}
      >
        <div
          className="relative w-full max-w-[580px] aspect-square"
          style={{ maxHeight: '88vh' }}
        >
          {/* Always StaticGlobe while Three.js CDN is being debugged.
              Change to `false &&` to re-enable canvas. */}
          {false && canvasRef ? (
            <canvas
              ref={canvasRef}
              className="w-full h-full"
              style={{ mixBlendMode: 'screen' }}
            />
          ) : (
            <StaticGlobe />
          )}
        </div>
      </div>

      {/* ── Text / CTA layer ─────────────────────────────────── */}
      <div className="relative z-10 h-screen flex items-center">
        <div className="container mx-auto px-6">
          <div className="grid lg:grid-cols-2 gap-12 items-center">
            {/* Left: content */}
            <motion.div
              initial={{ opacity: 0, x: -50 }}
              animate={{ opacity: 1, x: 0 }}
              transition={{ duration: 1, ease: [0.16, 1, 0.3, 1] }}
            >
              {/* Badge */}
              <motion.div
                initial={{ opacity: 0, y: -10 }}
                animate={{ opacity: 1, y: 0 }}
                transition={{ delay: 0.3, duration: 0.6 }}
                className="flex items-center gap-2 mb-8"
              >
                <div
                  className="w-2 h-2 rounded-full"
                  style={{
                    background: '#F59E0B',
                    boxShadow: '0 0 6px rgba(245,158,11,0.9)',
                  }}
                />
                <span
                  className="text-sm font-semibold tracking-[0.22em] uppercase"
                  style={{ fontFamily: "'Syncopate', sans-serif", color: '#F59E0B' }}
                >
                  Powered by Sunlight
                </span>
              </motion.div>

              {/* Headline */}
              <motion.h1
                initial={{ opacity: 0, y: 30 }}
                animate={{ opacity: 1, y: 0 }}
                transition={{ delay: 0.48, duration: 1, ease: [0.16, 1, 0.3, 1] }}
                className="mb-8 leading-[1.04]"
                style={{
                  fontFamily: "'Syncopate', sans-serif",
                  fontWeight: 700,
                  fontSize: 'clamp(2.2rem, 5.8vw, 4.8rem)',
                  color: '#F1F5F9',
                }}
              >
                Your Rooftop.{' '}
                <br />
                <span style={{ color: '#F59E0B' }}>Your Power Plant.</span>
              </motion.h1>

              {/* Sub-copy */}
              <motion.p
                initial={{ opacity: 0 }}
                animate={{ opacity: 1 }}
                transition={{ delay: 0.72, duration: 0.8 }}
                className="text-lg md:text-xl max-w-lg leading-relaxed mb-10"
                style={{ fontFamily: "'DM Sans', sans-serif", color: '#94a3b8' }}
              >
                Turn Bangladesh's sunshine into sustainable savings. Netso transforms
                rooftops into intelligent energy generators.
              </motion.p>

              {/* CTAs */}
              <motion.div
                initial={{ opacity: 0, y: 20 }}
                animate={{ opacity: 1, y: 0 }}
                transition={{ delay: 0.94, duration: 0.8 }}
                className="flex flex-col sm:flex-row gap-4"
              >
                <button
                  className="group relative px-8 py-4 rounded-xl text-base font-semibold flex items-center justify-center gap-2 overflow-hidden transition-all duration-300"
                  style={{
                    background: '#F59E0B',
                    color: '#060a10',
                    fontFamily: "'DM Sans', sans-serif",
                    boxShadow: '0 0 40px rgba(245,158,11,0.22)',
                  }}
                  onMouseEnter={(e) => {
                    e.currentTarget.style.boxShadow = '0 0 60px rgba(245,158,11,0.4)'
                    e.currentTarget.style.transform = 'translateY(-1px)'
                  }}
                  onMouseLeave={(e) => {
                    e.currentTarget.style.boxShadow = '0 0 40px rgba(245,158,11,0.22)'
                    e.currentTarget.style.transform = 'translateY(0)'
                  }}
                >
                  <span className="relative z-10 flex items-center gap-2">
                    Get Free Proposal
                    <ArrowRight
                      size={18}
                      className="group-hover:translate-x-1 transition-transform duration-200"
                    />
                  </span>
                </button>

                <button
                  className="px-8 py-4 rounded-xl text-base font-medium flex items-center justify-center gap-2 transition-all duration-300"
                  style={{
                    background: 'rgba(255,255,255,0.04)',
                    border: '1px solid rgba(255,255,255,0.09)',
                    color: '#cbd5e1',
                    fontFamily: "'DM Sans', sans-serif",
                    backdropFilter: 'blur(12px)',
                  }}
                  onMouseEnter={(e) => {
                    e.currentTarget.style.background = 'rgba(255,255,255,0.08)'
                    e.currentTarget.style.borderColor = 'rgba(255,255,255,0.18)'
                  }}
                  onMouseLeave={(e) => {
                    e.currentTarget.style.background = 'rgba(255,255,255,0.04)'
                    e.currentTarget.style.borderColor = 'rgba(255,255,255,0.09)'
                  }}
                >
                  See Installations
                </button>
              </motion.div>
            </motion.div>

            {/* Right: stats grid (desktop only) */}
            <motion.div
              initial={{ opacity: 0, scale: 0.92 }}
              animate={{ opacity: 1, scale: 1 }}
              transition={{ delay: 0.5, duration: 1, ease: [0.16, 1, 0.3, 1] }}
              className="hidden lg:grid grid-cols-2 gap-4"
            >
              {stats.map((stat, i) => (
                <motion.div
                  key={i}
                  initial={{ opacity: 0, y: 20 }}
                  animate={{ opacity: 1, y: 0 }}
                  transition={{ delay: 0.7 + i * 0.1, duration: 0.6 }}
                  className="p-5 rounded-2xl transition-all duration-300 cursor-default"
                  style={{
                    background: 'rgba(255,255,255,0.025)',
                    border: '1px solid rgba(255,255,255,0.06)',
                    backdropFilter: 'blur(16px)',
                    fontFamily: "'DM Sans', sans-serif",
                  }}
                  onMouseEnter={(e) => {
                    e.currentTarget.style.background = 'rgba(245,158,11,0.05)'
                    e.currentTarget.style.borderColor = 'rgba(245,158,11,0.25)'
                    e.currentTarget.style.transform = 'translateY(-2px)'
                  }}
                  onMouseLeave={(e) => {
                    e.currentTarget.style.background = 'rgba(255,255,255,0.025)'
                    e.currentTarget.style.borderColor = 'rgba(255,255,255,0.06)'
                    e.currentTarget.style.transform = 'translateY(0)'
                  }}
                >
                  <div
                    className="text-2xl font-semibold mb-0.5"
                    style={{ color: '#F1F5F9' }}
                  >
                    {stat.value}
                  </div>
                  <div className="text-sm" style={{ color: '#64748b' }}>
                    {stat.label}
                  </div>
                  <div className="text-xs mt-0.5" style={{ color: '#475569' }}>
                    {stat.sub}
                  </div>
                </motion.div>
              ))}
            </motion.div>
          </div>
        </div>
      </div>

      {/* ── Scroll indicator ────────────────────────────────── */}
      <motion.div
        initial={{ opacity: 0 }}
        animate={{ opacity: 1 }}
        transition={{ delay: 1.8, duration: 1 }}
        className="absolute bottom-8 left-1/2 -translate-x-1/2 z-20 flex flex-col items-center gap-2"
        style={{ pointerEvents: 'none' }}
      >
        <span
          className="text-xs tracking-widest uppercase"
          style={{
            fontFamily: "'DM Sans', sans-serif",
            color: 'rgba(148,163,184,0.4)',
            letterSpacing: '0.15em',
          }}
        >
          Scroll to explore
        </span>
        <div
          className="w-6 h-10 rounded-full flex justify-center"
          style={{ border: '1px solid rgba(255,255,255,0.12)', padding: 3 }}
        >
          <motion.div
            animate={{ y: [0, 14, 0], opacity: [1, 0, 1] }}
            transition={{ duration: 2.2, repeat: Infinity, ease: 'easeInOut' }}
            className="w-1 rounded-full"
            style={{ background: '#F59E0B' }}
          />
        </div>
      </motion.div>

      {/* ── Bottom vignette fade ─────────────────────────────── */}
      <div
        className="absolute bottom-0 left-0 right-0 h-40 pointer-events-none z-10"
        style={{
          background: 'linear-gradient(to top, #0A0D14 0%, transparent 100%)',
        }}
      />
    </section>
  )
}
